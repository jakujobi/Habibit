# Habibit WordPress Environment Configuration
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
DB_NAME=habibit_db
DB_USER=habibit_user
DB_PASSWORD=change_this_secure_password
DB_HOST=localhost
DB_CHARSET=utf8mb4
DB_COLLATE=

# Table prefix for WordPress database
# Change from default 'wp_' for additional security
TABLE_PREFIX=hb_

# ==============================================
# WORDPRESS CONFIGURATION
# ==============================================

# WordPress debugging (set to false in production)
WP_DEBUG=false
WP_DEBUG_LOG=false
WP_DEBUG_DISPLAY=false
SCRIPT_DEBUG=false

# WordPress URLs (update with your domain)
WP_HOME=http://localhost
WP_SITEURL=http://localhost

# Force HTTPS in production (set to true when using SSL)
FORCE_SSL_ADMIN=false

# ==============================================
# SECURITY KEYS & SALTS
# ==============================================
# Generate unique keys from: https://api.wordpress.org/secret-key/1.1/salt/
# Replace these placeholder values with generated keys

AUTH_KEY='put your unique phrase here'
SECURE_AUTH_KEY='put your unique phrase here'
LOGGED_IN_KEY='put your unique phrase here'
NONCE_KEY='put your unique phrase here'
AUTH_SALT='put your unique phrase here'
SECURE_AUTH_SALT='put your unique phrase here'
LOGGED_IN_SALT='put your unique phrase here'
NONCE_SALT='put your unique phrase here'

# ==============================================
# WOOCOMMERCE CONFIGURATION
# ==============================================

# Tax rate (default 2.5% to match CLI implementation)
WC_TAX_RATE=2.5

# Currency
WC_CURRENCY=USD

# ==============================================
# EMAIL CONFIGURATION (Optional)
# ==============================================
# SMTP settings for transactional emails

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_SECURE=tls
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Habibit Equipment Rental

# ==============================================
# PERFORMANCE & CACHING (Optional)
# ==============================================

# Memory limit for PHP
WP_MEMORY_LIMIT=256M
WP_MAX_MEMORY_LIMIT=512M

# Enable/disable caching
WP_CACHE=false

# ==============================================
# DEVELOPMENT/STAGING CONFIGURATION
# ==============================================

# Environment type (development, staging, production)
WP_ENVIRONMENT_TYPE=development

# Allow/disallow file editing from WordPress admin
DISALLOW_FILE_EDIT=true
DISALLOW_FILE_MODS=false

# ==============================================
# DOCKER CONFIGURATION (if using Docker)
# ==============================================

# MySQL Docker settings
MYSQL_ROOT_PASSWORD=root_password_here
MYSQL_DATABASE=habibit_db
MYSQL_USER=habibit_user
MYSQL_PASSWORD=habibit_password

# PHP-FPM settings
PHP_VERSION=7.4
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=300

# Nginx settings
NGINX_PORT=80
NGINX_SSL_PORT=443

# ==============================================
# BACKUP CONFIGURATION (Optional)
# ==============================================

# Backup directory path
BACKUP_DIR=/var/backups/habibit

# Backup retention (days)
BACKUP_RETENTION=30

# ==============================================
# NOTES
# ==============================================
# - Replace all 'change_this_*' and 'your_*' values
# - Generate strong passwords using: openssl rand -base64 32
# - Keep this file secure and never commit to public repositories
# - Update WP_HOME and WP_SITEURL for your domain
# - Set WP_DEBUG=false in production
# - Enable FORCE_SSL_ADMIN=true when using HTTPS
